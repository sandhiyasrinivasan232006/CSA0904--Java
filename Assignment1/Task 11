TASK 11 – Implement, Test and Defend the Design (5 Marks)
1. Complete Java Implementation
The Parking Management System uses:
•	Encapsulation: Private fields with controlled access.
•	Inheritance: Car and TwoWheeler extend Vehicle.
•	Polymorphism: Different vehicle types have different parking fees.
•	Abstraction: Vehicle is an abstract class.
•	Interface: Chargeable represents electric vehicle charging capability.
Fee assumptions:
•	Bike: ₹10 per hour.
•	Car: ₹30 per hour.
•	Electric Car: ₹30 per hour.
•	Every started hour is charged in full.
•	Zero-minute parking has zero fee.
2. Java Program
Save the following program as ParkingSystemDemo.java.
abstract class Vehicle {
    private String regNo;
    Vehicle(String regNo) {
        this.regNo = regNo;
    }
    public String getRegNo() {
        return regNo;
    }
    abstract double calculateFee(int minutes);
}
interface Chargeable {
    double chargingFee(int units);
}

class TwoWheeler extends Vehicle {
    TwoWheeler(String regNo) {
        super(regNo);
    }
    @Override
    double calculateFee(int minutes) {
        return (minutes + 59) / 60 * 10;
    }
}
class Car extends Vehicle {
    Car(String regNo) {
        super(regNo);
    }
    @Override
    double calculateFee(int minutes) {
        return (minutes + 59) / 60 * 30;
    }
}
class ElectricCar extends Car implements Chargeable {
    ElectricCar(String regNo) {
        super(regNo);
    }
    @Override
    public double chargingFee(int units) {
        return units * 12;
    }
}
class ParkingTicket {
    Vehicle vehicle;
    int floor;
    int slot;

    ParkingTicket(Vehicle vehicle, int floor, int slot) {
        this.vehicle = vehicle;
        this.floor = floor;
        this.slot = slot;
    }
}
class ParkingFacility {
    private String[][] slots;
    private ParkingTicket[] tickets;
    private double collection = 0;
    ParkingFacility(int floors, int slotsPerFloor) {
        slots = new String[floors][slotsPerFloor];
        tickets = new ParkingTicket[floors * slotsPerFloor];
    }
    public boolean enter(Vehicle v) {
        if (v == null) {
            System.out.println("Invalid vehicle type");
            return false;
        }
        for (ParkingTicket t : tickets) {
            if (t != null &&
                t.vehicle.getRegNo().equals(v.getRegNo())) {
                System.out.println("Duplicate registration");
                return false;
            }
        }
        for (int f = 0; f < slots.length; f++) {
            for (int s = 0; s < slots[f].length; s++) {
                if (slots[f][s] == null) {
                    slots[f][s] = v.getRegNo();
                    for (int i = 0; i < tickets.length; i++) {
                        if (tickets[i] == null) {
                            tickets[i] =
                                new ParkingTicket(v, f, s);
                            break;
                        }
                    }
                    System.out.println("Vehicle parked: "
                        + v.getRegNo());
                    return true;
                }
            }
        }
        System.out.println("Parking full");
        return false;
    }
    public double exit(String regNo, int minutes, int units) {
        if (minutes < 0) {
            System.out.println("Invalid duration");
            return -1;
        }
        for (int i = 0; i < tickets.length; i++) {
            ParkingTicket t = tickets[i];
            if (t != null &&
                t.vehicle.getRegNo().equals(regNo)) {
                double fee = t.vehicle.calculateFee(minutes);
                if (t.vehicle instanceof Chargeable c) {
                    fee += c.chargingFee(units);
                }
                slots[t.floor][t.slot] = null;
                tickets[i] = null;
                collection += fee;
                System.out.println("Exit successful: " + regNo);
                return fee;
            }
        }
        System.out.println("Vehicle not found");
        return -1;
    }
    public boolean releaseSlot(int floor, int slot) {
        if (floor < 0 || floor >= slots.length ||
            slot < 0 || slot >= slots[floor].length) {
            return false;
        }
        if (slots[floor][slot] == null) {
            return false;
        }
        slots[floor][slot] = null;
        return true;
    }
    public double getCollection() {
        return collection;
    }
}
public class ParkingSystemDemo {
    public static void main(String[] args) {
        ParkingFacility p = new ParkingFacility(2, 2);
        p.enter(new TwoWheeler("TN01A1111"));
        p.enter(new Car("TN02B2222"));
        p.enter(new ElectricCar("TN03C3333"));
        // Duplicate registration test
        p.enter(new Car("TN02B2222"));
        // Unknown vehicle type test
        p.enter(null);
        // Parking fee calculation
        System.out.println("Bike Fee: " +
            p.exit("TN01A1111", 30, 0));
        System.out.println("Car Fee: " +
            p.exit("TN02B2222", 60, 0));
        System.out.println("Electric Car Fee: " +
            p.exit("TN03C3333", 61, 0));
        // Boundary tests
        System.out.println("Zero Minute Fee: " +
            new Car("TN04D4444").calculateFee(0));
        System.out.println("Boundary Fee: " +
            new Car("TN05E5555").calculateFee(60));
        // Invalid slot test
        System.out.println("Invalid Slot: " +
            p.releaseSlot(5, 0));
        System.out.println("Total Collection: Rs " +
            p.getCollection());
    }
}

