TASK 3 – Design the Control Logic (4 Marks)
1. Pseudocode for Slot Allocation
Algorithm: AllocateSlot(vehicleNo)
1. START
2. FOR each floor f in parking facility
3. FOR each slot s in floor
4. IF slot is NULL
5. Assign vehicle number to slot
6. RETURN floor and slot
7. END FOR
8. END FOR
9. PRINT "Parking Full"
10. RETURN NULL
11. STOP
2. Pseudocode for Parking Fee Calculation
Algorithm: CalculateFee(minutes)
1. START
2. Convert minutes into hours using floating-point division.
3. IF duration is within the first hour
   - Fee = Rs. 20
4. ELSE IF duration is within 24 hours
   - Fee = Rs. 20 + (additional hours × Rs. 10)
5. ELSE
   - Apply daily maximum fee of Rs. 200 per day.
6. RETURN fee
7. STOP
Assumption: First hour = ₹20, each additional hour = ₹10, daily maximum = ₹200.
3. Use of break, continue and return
- break: Stops the loop when a free slot is found.
- continue: Skips an occupied slot and checks the next slot.
- return: Returns the allocated floor and slot immediately.
- If no slot is available, the method returns null.
4. Completed Java Program

public class ParkingFacility {

    private final String[][] slots;

    public ParkingFacility(int[] slotsPerFloor) {
        slots = new String[slotsPerFloor.length][];

        for (int f = 0; f < slotsPerFloor.length; f++) {
            slots[f] = new String[slotsPerFloor[f]];
        }
    }

    public int[] allocate(String vehicleNo) {

        for (int f = 0; f < slots.length; f++) {
            for (int s = 0; s < slots[f].length; s++) {

                if (slots[f][s] == null) {
                    slots[f][s] = vehicleNo;
                    return new int[]{f, s};
                }
            }
        }

        return null;
    }

    public boolean release(int floor, int slot) {

        if (floor < 0 || floor >= slots.length) {
            return false;
        }

        if (slot < 0 || slot >= slots[floor].length) {
            return false;
        }

        if (slots[floor][slot] == null) {
            return false;
        }

        slots[floor][slot] = null;
        return true;
    }

    public static void main(String[] args) {

        ParkingFacility p = new ParkingFacility(new int[]{2, 1});

        System.out.println(java.util.Arrays.toString(p.allocate("TN01AB1111")));
        System.out.println(java.util.Arrays.toString(p.allocate("TN02CD2222")));
        System.out.println(java.util.Arrays.toString(p.allocate("TN03EF3333")));
        System.out.println(java.util.Arrays.toString(p.allocate("TN04GH4444")));

        System.out.println(p.release(0, 1) + " " +
                p.release(0, 1) + " " + p.release(5, 0));

        System.out.println(java.util.Arrays.toString(p.allocate("TN04GH4444")));
    }
}



